{
  "name": "tango-ts",
  "version": "0.0.0",
  "private": true,
  "description": "Django REST Framework, in TypeScript, for serverless. Monorepo root.",
  "repository": "https://github.com/bryanhoulton/tango.git",
  "author": "Bryan Houlton <brhoulton@gmail.com>",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf packages/*/dist",
    "changeset": "changeset",
    "version-packages": "changeset version && yarn install",
    "release": "yarn build && changeset publish",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "yarn build && vitest run --config vitest.package.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:deployed": "TANGO_DB_NAME=tango_test vitest run --config vitest.deployed.config.ts --passWithNoTests",
    "test:all": "yarn typecheck && yarn lint && yarn test && yarn test:package && yarn test:integration && yarn test:deployed",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": "eslint --max-warnings=0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.8.10",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
