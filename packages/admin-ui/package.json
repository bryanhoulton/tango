{
  "name": "@tango-ts/admin-ui",
  "version": "0.6.0",
  "description": "The Tango admin UI: a prebuilt, schema-driven React SPA (shadcn/ui) served as static assets. Ships compiled dist/ only — never import this from server code.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tango-ts/admin": "*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "slate-ui": "^1.3.26",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "vite": "^8.0.16"
  }
}
