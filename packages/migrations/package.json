{
  "name": "@tango-ts/migrations",
  "version": "0.8.1",
  "description": "Tango migrations: schema snapshots and the autodetector that diffs models into typed operations.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "kysely": "^0.29.2"
  },
  "peerDependencies": {
    "@tango-ts/core-types": "*",
    "@tango-ts/orm": "*"
  }
}
