{
  "name": "@tango-ts/views",
  "version": "0.9.0",
  "description": "DRF-style API views and ModelViewSet for Tango.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
