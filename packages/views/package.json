  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@tango-ts/auth": "*",
    "@tango-ts/core-types": "*",
    "@tango-ts/http": "*",
    "@tango-ts/orm": "*",
    "@tango-ts/router": "*",
    "@tango-ts/serializers": "*"
  }
}
