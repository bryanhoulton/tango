{
  "name": "@tango-ts/server",
  "version": "0.5.0",
  "description": "Declarative server entrypoint helpers for Tango apps.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tango-ts/adapters": "*",
    "@tango-ts/auth": "*",
    "@tango-ts/http": "*",
    "@tango-ts/orm": "*",
    "@tango-ts/router": "*",
    "kysely": "^0.29.2"
  }
}
