{
  "name": "@tango-ts/admin",
  "version": "0.6.0",
  "description": "Schema-driven admin API for Tango: model metadata, staff-gated auth, and admin CRUD viewsets. Pure JSON — the React UI ships separately in @tango-ts/admin-ui as static assets, so this package adds no UI weight to serverless function bundles.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tango-ts/auth": "*",
    "@tango-ts/contrib-auth": "*",
    "@tango-ts/core-types": "*",
    "@tango-ts/http": "*",
    "@tango-ts/orm": "*",
    "@tango-ts/router": "*",
    "@tango-ts/serializers": "*",
    "@tango-ts/server": "*",
    "@tango-ts/views": "*"
  }
}
