{
  "name": "@tango-ts/cli",
  "version": "0.8.1",
  "description": "Tango management commands: makemigrations, migrate, and migration checks.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tango": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "kysely": "^0.29.2"
  },
  "peerDependencies": {
    "@tango-ts/adapters": "*",
    "@tango-ts/contrib-auth": "*",
    "@tango-ts/migrations": "*",
    "@tango-ts/orm": "*"
  }
}
