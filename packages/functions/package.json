{
  "name": "@tango-ts/functions",
  "version": "0.1.0",
  "description": "Internal serverless functions for Tango apps: defined per app, invoked from Tango logic, never part of the public API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tango-ts/http": "*",
    "@tango-ts/orm": "*",
    "kysely": "^0.29.2"
  }
}
