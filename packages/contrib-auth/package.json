{
  "name": "@tango-ts/contrib-auth",
  "version": "0.4.0",
  "description": "Batteries-included auth app for Tango: User and AuthToken models, password hashing, token issuing routes, and a ready-made authentication class.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tango-ts/auth": "*",
    "@tango-ts/core-types": "*",
    "@tango-ts/http": "*",
    "@tango-ts/orm": "*",
    "@tango-ts/router": "*"
  }
}
