{
  "name": "@tango-ts/orm",
  "version": "0.5.0",
  "description": "Tango ORM: declarative models, managers, lazy querysets, Django-style lookups, compiled to Kysely (MySQL).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tango-ts/core-types": "*",
    "kysely": "^0.29.2",
    "mysql2": "^3.22.5"
  }
}
