{
  "name": "@tango-ts/serializers",
  "version": "0.2.0",
  "description": "Tango serializers: DRF-style validation and model serialization with inferred TypeScript types.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tango-ts/core-types": "*",
    "@tango-ts/orm": "*"
  }
}
