{
  "name": "@tango-ts/openapi",
  "version": "0.1.2",
  "description": "OpenAPI schema generation for Tango routers and viewsets.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tango-ts/orm": "*",
    "@tango-ts/router": "*",
    "@tango-ts/server": "*",
    "@tango-ts/views": "*"
  }
}
